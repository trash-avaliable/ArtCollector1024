{
  "name": "refcollector",
  "version": "0.5.0",
  "description": "RefCollector - 画师参考图收集器",
  "main": "electron/main.js",
  "author": "RefCollector",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "vite",
    "dev:electron": "cross-env VITE_DEV=1 electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test": "node --test tests/*.test.mjs",
    "bench:clip": "electron scripts/clip-benchmark.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0",
    "pinyin-pro": "^3.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.refcollector.app",
    "productName": "RefCollector",
    "asarUnpack": [
      "**/*.node",
      "**/onnxruntime-node/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "pin.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RefCollector",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ]
  }
}
